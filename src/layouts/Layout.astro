---
import "@/styles/global.css";
import ThemeInit from "@/components/effects/ThemeInit.astro";
import StarField from "@/components/effects/StarField.astro";
import { ScrollProgress } from "@/components/effects/ScrollProgress";
import { Navbar } from "@/components/sections/Navbar";
---

<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Mario Avila</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased">
    <ScrollProgress client:load />
    <StarField />
    <Navbar client:load />
    <main id="main-content" class="relative z-10 pb-20 md:pb-0">
      <slot />
    </main>
    <footer></footer>
  </body>
</html>
